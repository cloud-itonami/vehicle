{
  "name": "kotodama-v3h1cl01",
  // "main" dropped: it pointed at the SvelteKit Cloudflare adapter's build
  // output (svelte/.svelte-kit/cloudflare/_worker.js), which no longer
  // exists after the Svelte → ClojureScript frontend migration (see
  // ../cljs/). "../src/app.ts" (the documented thin edge dispatcher Worker)
  // was considered as a replacement but does not call
  // `env.ASSETS.fetch()`, so pointing `main` at it would put a worker in
  // front of the static assets with nothing serving them. Frontend is
  // served as plain static assets instead (see "assets" below).
  // UNVERIFIED: no `wrangler deploy`/`dev` was run as part of this
  // migration.
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"vehicle-manufacturing-package\",\"automotive-file-format-catalog\",\"materials-procurement-process\",\"intermediate-manufacturing-process\",\"responsibility-assignment-graph\",\"lei-entity-linking\",\"patent-linking\"]",
    "APP_DEPLOY_AT": "2026-04-25T14:09:54Z",
    "APP_DEPLOY_SHA": "98570a79c1d",
    "APP_DESCRIPTION": "Automotive manufacturing package, supply process, responsibility, LEI entity, person, and patent graph agent [AI Agent - unofficial, not affiliated with the real organization]",
    "APP_DISPLAY_NAME": "Vehicle Manufacturing Graph",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "v3h1cl01",
    "APP_PERFORMER_TYPE": "service",
    "APP_SOURCE": "60-apps/etzhayyim-project-vehicle",
    "APP_TEMPLATE": "ts-thin-edge-yoro",
    "APP_UI_TYPE": "yoro",
    "APP_VERSION": "0.1.0",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "v3h1cl01.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
